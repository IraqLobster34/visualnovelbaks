# Dialogue and narration from story/chapter2.txt.
image bg tribunal = Transform("images/tribunal.png", size=(1920, 1080))
image bg admin_corridor = Transform("images/admin-corridor.png", size=(1920, 1080))
image bg bulletin_counter = Transform("images/bulletin-counter.png", size=(1920, 1080))

define bulletin_department = "Отдел аномальных культов."
define bulletin_series = "Открытый цикл лекций руководителя отдела, доктора Якова Манишека."
define bulletin_topic_heading = "Тема ближайшего заседания:"
define bulletin_topic = "Саркические традиции и закрытые культы — структурный анализ."
define bulletin_access = "Допуск для персонала от 2 уровня в свободное от смены время"
define bulletin_announcement = "«" + " ".join((
    bulletin_department, bulletin_series, bulletin_topic_heading, bulletin_topic, bulletin_access)) + "»"

image bg bulletin_detail = Composite(
    (1920, 1080),
    (0, 0), Transform("images/bulletin-detail.png", size=(1920, 1080)),
    (352, 132), Text("НАУЧНАЯ СЛУЖБА УВС-19F", size=22, kerning=2, color="#634335"),
    (1066, 132), Text("ИНФОРМАЦИОННЫЙ БЮЛЛЕТЕНЬ", size=22, kerning=2, color="#634335"),
    (352, 235), Text(bulletin_department, size=48, bold=True, color="#2e211c"),
    (352, 315), Text(bulletin_series, size=31, xmaximum=1190, color="#362821"),
    (352, 397), Text(bulletin_topic_heading, size=27, color="#634335"),
    (352, 439), Text(bulletin_topic, size=42, bold=True, xmaximum=1190, color="#2e211c"),
    (352, 565), Solid("#b38d73", xysize=(1190, 2)),
    (352, 595), Text(bulletin_access, size=31, xmaximum=1190, color="#634335"))

transform bulletin_push_in:
    subpixel True
    align (0.5, 0.5)
    zoom 1.0
    easeout 0.38 zoom 1.04

label chapter_two:
    $ active_speaker = ""
    $ tribunal_brando_present = False
    $ tribunal_in_corridor = False
    $ chapter = "ВНУТРЕННИЙ ТРИБУНАЛ"
    scene bg tribunal
    show screen scene_header("ПЕРЕГОВОРНАЯ Б-4")
    $ story_music = "audio/tribunal-main-theme.mp3"
    play music story_music loop fadeout 0.5 fadein 1.0 volume 0.45
    with Fade(0.28, 0.10, 0.45)
    window show
    narrator "[[ПРОТОКОЛ ЗАСЕДАНИЯ ВЫЕЗДНОЙ КОЛЛЕГИИ СЛУЖБЫ ВНУТРЕННЕГО ТРИБУНАЛА]" id chapter_two_001
    narrator "[[УЧАСТОК ВРЕМЕННОГО СОДЕРЖАНИЯ 19F, ПЕРЕГОВОРНЫЙ БЛОК Б-4]" id chapter_two_002
    narrator "Тяжёлая металлическая дверь закрывается за спиной Ларри Бакса с сухим механическим щелчком." id chapter_two_003
    narrator "В комнате нет окон. Стены обшиты серыми звукопоглощающими панелями, воздух заметно прохладнее, чем в административном коридоре." id chapter_two_004
    narrator "По центру стоит длинный стол. Напротив единственного пустого стула сидят двое мужчин в строгих тёмных костюмах — Джейкоб Фазен и Ирвин Болдерик." id chapter_two_005
    narrator "Перед Фазеном лежит тонкая светлая папка с аккуратными красными закладками. Перед Болдериком — толстый серый том архивного образца с потёртым корешком." id chapter_two_006
    narrator "Чуть сбоку, ближе к центру стола, стоит стеклянный стакан с водой и мигает ровным красным светом индикатор диктофона." id chapter_two_007
    narrator "Бакс не торопится садиться. Несколько секунд он осматривает комнату, затем переводит взгляд на обоих следователей." id chapter_two_008
    show screen cast_stage(tribunal=True)
    with Dissolve(0.25)
    $ active_speaker = "bucks"
    bucks "Добрый день, господа. Прошу прощения, если заставил ждать. На пропускном пункте вашего крыла сегодня на редкость обстоятельный досмотр." id chapter_two_009
    $ active_speaker = "fazen"
    fazen "Садитесь, мистер Бакс. Заседание уже началось." id chapter_two_010
    $ active_speaker = "bucks"
    bucks "Благодарю." id chapter_two_011
    $ active_speaker = ""
    narrator "Бакс расстёгивает нижнюю пуговицу жилета, неспешно отодвигает стул и садится. Поправляет очки." id chapter_two_012
    $ active_speaker = "fazen"
    fazen "Протокол ведётся в полном объёме. Присутствуют старшие следователи Службы Внутреннего Трибунала Ирвин Болдерик и Джейкоб Фазен, а также сотрудник Отдела Внешних Связей УВС-19F Ларри Бакс." id chapter_two_013
    $ active_speaker = "bucks"
    bucks "Заместитель начальника отдела, если быть точным." id chapter_two_014
    $ active_speaker = "fazen"
    fazen "Временно — до вынесения решения коллегии." id chapter_two_015
    $ active_speaker = "bucks"
    bucks "О, как оперативно. Приятно видеть, что бюрократический аппарат Фонда способен работать быстро, когда действительно этого хочет." id chapter_two_016
    $ active_speaker = ""
    narrator "Ирвин Болдерик молчит, сложив пальцы домиком перед собой. Он не отрывает от Бакса спокойного, изучающего взгляда." id chapter_two_017
    $ active_speaker = "fazen"
    fazen "Вы инициировали обращение с требованием пересмотра кадрового решения директора Участка Молли Брандо, а также запросили материалы конкурсного отбора на должность начальника ОВС." id chapter_two_018
    $ active_speaker = "bucks"
    bucks "Совершенно верно. В пределах установленного допуска." id chapter_two_019
    $ active_speaker = "fazen"
    fazen "И одновременно в адрес Трибунала поступило представление администрации УВС-19F о нарушении вами служебной субординации. В связи с чем коллегия объединила оба материала в единое производство." id chapter_two_020
    $ active_speaker = "bucks"
    bucks "Единое производство. Звучит почти торжественно." id chapter_two_021
    $ active_speaker = "fazen"
    fazen "Это не светская беседа, мистер Бакс. На повестке не только ваше заявление, но и вопрос о вашей профессиональной компетенции." id chapter_two_022
    $ active_speaker = ""
    narrator "Бакс едва заметно усмехается и кивает на толстую серую папку перед Болдериком." id chapter_two_023
    $ active_speaker = "bucks"
    bucks "И о моей лояльности Организации." id chapter_two_024
    $ active_speaker = ""
    narrator "Фазен на долю секунды замирает. Его пальцы слегка сжимают край светлой папки." id chapter_two_025
    $ active_speaker = "fazen"
    fazen "С чего вы это взяли?" id chapter_two_026
    $ active_speaker = "bucks"
    bucks "О, простая наблюдательность." id chapter_two_027
    $ active_speaker = ""
    narrator "Бакс слегка наклоняется вперёд, опираясь предплечьями о стол." id chapter_two_028
    $ active_speaker = "bucks"
    bucks "Температура в помещении опущена градусов на пять ниже нормы. Стандартный приём для длительных бесед: лёгкий озноб незаметно подталкивает человека говорить быстрее, лишь бы поскорее закончить и выйти в тепло." id chapter_two_029
    $ active_speaker = "fazen"
    fazen "Система вентиляции в этом блоке работает по общему графику." id chapter_two_030
    $ active_speaker = "bucks"
    bucks "Разумеется. И стакан с водой поставлен ровно на десять сантиметров дальше зоны удобного досягания, чтобы каждый раз, когда у меня пересохнет во рту, мне приходилось тянуться вперёд и нарушать собственную позу." id chapter_two_031
    $ active_speaker = "bolderik"
    bolderik "Вы неплохо разбираетесь в планировке допросных, мистер Бакс." id chapter_two_032
    $ active_speaker = "bucks"
    bucks "Опыт работы в дипломатии и ОВС, мистер Болдерик. Впрочем, самое интересное — не вода и не кондиционер." id chapter_two_033
    $ active_speaker = ""
    narrator "Бакс переводит взгляд с Фазена на Болдерика." id chapter_two_034
    $ active_speaker = "bucks"
    bucks "Вы прислали сюда двоих старших членов комиссии по инциденту G-19. Из-за спора о кресле начальника отдела на одном экспериментальном Участке. Право слово, я польщён. Не думал, что моя скромная жалоба заслуживает такого представительного состава." id chapter_two_035
    $ active_speaker = "fazen"
    fazen "Состав коллегии назначается руководством СВТ и не подлежит обсуждению." id chapter_two_036
    $ active_speaker = "bucks"
    bucks "Конечно-конечно. Просто забавно, что мистер Фазен за последнюю минуту дважды покосился на ваши наручные часы, мистер Болдерик. Не потому, что боится опоздать на обед — а потому, что ждёт сигнала, когда можно будет отложить светлую папку и перейти к серой." id chapter_two_037
    $ active_speaker = ""
    narrator "Фазен резко переводит взгляд на Бакса." id chapter_two_038
    $ active_speaker = "fazen"
    fazen "Вам стоит следить за тем, что вы говорите под запись." id chapter_two_039
    $ active_speaker = "bolderik"
    bolderik "Нет, Джейкоб. Пусть продолжает." id chapter_two_040
    $ active_speaker = ""
    narrator "Болдерик впервые меняет позу, слегка откидываясь на спинку стула." id chapter_two_041
    $ active_speaker = "bolderik"
    bolderik "В вашем личном деле указано, что ваша мать была частным психотерапевтом. Вижу, семейные навыки пережили переезд из Манчестера." id chapter_two_042
    $ active_speaker = ""
    narrator "Улыбка Бакса становится чуть более сухой." id chapter_two_043
    $ active_speaker = "bucks"
    bucks "Мать научила меня слушать людей, мистер Болдерик. А отец — не верить тем, кто начинает разговор с намёков на твою биографию." id chapter_two_044
    $ active_speaker = "bolderik"
    bolderik "Ваш отец, насколько мне известно, плохо закончил с таким подходом. Ему пришлось бежать из Великобритании в российское посольство." id chapter_two_045
    $ active_speaker = "bucks"
    bucks "Зато он остался жив и свободен. В политике это считается вполне приличным результатом." id chapter_two_046
    $ active_speaker = "bolderik"
    bolderik "В Фонде критерии успеха несколько строже." id chapter_two_047
    $ active_speaker = ""
    narrator "Тишина в комнате становится плотной. Мигает красный огонёк диктофона." id chapter_two_048
    $ active_speaker = "bolderik"
    bolderik "Хорошо. Раз вы предпочитаете не тратить время на вступления, начнём по существу. Джейкоб?" id chapter_two_049
    $ active_speaker = ""
    narrator "Фазен открывает светлую папку и выкладывает на стол распечатку." id chapter_two_050
    $ active_speaker = "fazen"
    fazen "Приложение к рапорту директора Брандо. Аудиостенограмма беседы в её кабинете в присутствии новоназначенного начальника ОВС Александра Морэ. Вы подтверждаете подлинность этого разговора?" id chapter_two_051
    $ active_speaker = "bucks"
    bucks "Если в ней сохранены все мои удачные реплики — безусловно." id chapter_two_052
    $ active_speaker = "fazen"
    fazen "Вы вошли в кабинет директора после окончания рабочего дня без приглашения. Поставили под сомнение кадровое решение руководства. Перебивали директора, провоцировали её и господина Морэ на эмоциональную реакцию, а затем фактически пригрозили обращением в Трибунал." id chapter_two_053
    $ active_speaker = "bucks"
    bucks "Маленькое уточнение. Про Трибунал первой заговорила Молли. Сверьтесь со страницей восемнадцать — или где там у вас красная закладка." id chapter_two_054
    $ active_speaker = ""
    narrator "Фазен смотрит на Бакса поверх листа." id chapter_two_055
    $ active_speaker = "fazen"
    fazen "Вы действительно считаете, что игра словами способна отменить суть произошедшего?" id chapter_two_056
    $ active_speaker = "bucks"
    bucks "Суть в том, что я задал своему директору прямой вопрос о критериях отбора. В ответ мне сорок минут объясняли, что я замечательный специалист, но слишком неудобный человек." id chapter_two_057
    $ active_speaker = "fazen"
    fazen "Вам сообщили, что начальник ОВС должен обеспечивать исполнение решений, а не оспаривать приказы. Вы же на протяжении всей беседы демонстрировали именно то качество, из-за которого вам отказали." id chapter_two_058
    $ active_speaker = "bucks"
    bucks "Потрясающий логический круг. Если я молчу — значит, согласен с несправедливым решением. Если возражаю — значит, подтверждаю, что мне нельзя доверять руководство. Кафка аплодировал бы стоя." id chapter_two_059
    $ active_speaker = "fazen"
    fazen "Это не литература, мистер Бакс. Это ваш медицинский и психологический профиль." id chapter_two_060
    $ active_speaker = ""
    narrator "Фазен переворачивает лист." id chapter_two_061
    $ active_speaker = "fazen"
    fazen "Двадцать четвёртое февраля две тысячи двадцать первого года. Инцидент G-19. Тяжёлое ранение головы при эвакуации, хирургическая эвакуация внутричерепных гематом, продолжительная кома. Затем — диагностированная депрессия и курс препаратов группы СИОЗС вплоть до двадцать второго года." id chapter_two_062
    $ active_speaker = ""
    narrator "Бакс не меняет выражения лица. Только взгляд за стёклами очков становится холоднее." id chapter_two_063
    $ active_speaker = "fazen"
